nextflow.enable.dsl = 2
manifest {
    name = 'long-read-variant-pipeline'
    description = 'Human germline HiFi and ONT preprocessing, variant calling and phasing'
    version = '0.1.0'
    nextflowVersion = '!25.10.4'
}
params {
    samples = []
    reference_fasta = null
    reference_sha256 = null
    reference_contigs = [:]
    regions = null
    outdir = 'results'
    cpus = 8
    memory_gb = 32
    executor_name = 'local'
    queue = ''
    help = false
}
includeConfig 'configs/longread-containers.config'
process {
    executor = params.executor_name
    cpus = params.cpus as int
    memory = "${params.memory_gb} GB"
    time = '48h'
    queue = params.queue ?: null
    errorStrategy = 'terminate'
    shell = ['/bin/bash', '-euo', 'pipefail']
    withLabel: light {
        cpus = 1
        memory = '4 GB'
    }
}
executor {
    cpus = params.cpus as int
    memory = "${params.memory_gb} GB"
    queueSize = 16
}
profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '--user $(id -u):$(id -g)'
    }
    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
    }
}
trace {
    enabled = true
    file = "${params.outdir}/provenance/trace.tsv"
    overwrite = true
    fields = 'task_id,hash,native_id,name,status,exit,submit,start,complete,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,cpus,memory,container'
}
report {
    enabled = true
    file = "${params.outdir}/provenance/execution-report.html"
    overwrite = true
}
timeline {
    enabled = true
    file = "${params.outdir}/provenance/timeline.html"
    overwrite = true
}
dag {
    enabled = true
    file = "${params.outdir}/provenance/workflow-dag.html"
    overwrite = true
}
